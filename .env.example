UPSTREAM_BASE_URL=http://localhost:8001
DATABASE_URL=postgresql+asyncpg://postgres:devpassword@localhost:5432/gate
TEST_DATABASE_URL=postgresql+asyncpg://postgres:devpassword@localhost:5432/gate_test
# Required. Signs pagination cursors. Production must set its own long random
# value, the same on every instance and across restarts:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
SECRET_KEY=
# Local development only: lets the app start without SECRET_KEY by using a
# fixed, publicly known key. Never set this in production.
# DEV=true
